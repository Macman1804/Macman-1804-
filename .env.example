# Public project URL and publishable key only. Never put a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Do not prefix these with VITE_. Do not commit values. Do not paste them in chat.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# Optional shared caller ID. A subscriber number, when one is assigned, is used instead.
# TWILIO_VOICE_NUMBER=
# Public https URL Twilio would call. Leave empty until a number and billing are approved.
# TWILIO_WEBHOOK_URL=
# Leave unset. The app refuses every call even if this is set to true.
# TWILIO_CALLS_ENABLED=

# Server only. Used later to seal a mailbox token. Do not commit a value. Do not paste it in chat.
# MAILBOX_TOKEN_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# Server only. Leave unset until a hosted payment provider is approved. No card data belongs here.
# BILLING_WEBHOOK_SECRET=



